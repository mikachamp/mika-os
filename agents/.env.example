# Agent OS — Environment Variables
# Copy this to .env and fill in your keys
# NEVER commit .env to git

# ── Local LLM (LM Studio) ────────────────────────────
# agents/shared/llm.js is local-first: it calls the model loaded in LM Studio and
# falls back to Gemini only when LM Studio isn't running or the call fails.
# LLM_PROVIDER: auto (local, then Gemini) · local (never use the cloud) · gemini
LLM_PROVIDER=auto
LOCAL_LLM_URL=http://127.0.0.1:1234
LOCAL_LLM_MODEL=google/gemma-4-e4b
LOCAL_LLM_TIMEOUT_MS=120000

# ── Cloud LLM ────────────────────────────────────────
# Gemini is the fallback. The Anthropic key is still used directly by the
# researcher agent (Claude's web-search tool).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Obsidian Vault ───────────────────────────────────
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian-vault

# ── Orchestrator ─────────────────────────────────────
ORCHESTRATOR_PORT=3001

# ── Agent Ports ──────────────────────────────────────
LIFE_ADMIN_PORT=3002
FITNESS_PORT=3003
LEARNING_PORT=3004
MEMORY_PORT=3005
VAULT_MANAGER_PORT=3006
RESEARCHER_PORT=3007
BUILDER_PORT=3008
BUSINESS_EXPERT_PORT=3009
MANUFACTURING_EXPERT_PORT=3010
CAREER_EXPERT_PORT=3011
NETWORK_SECURITY_PORT=3012
IT_SECURITY_PORT=3013
MAINTENANCE_PORT=3014
OFFLINE_LLM_PORT=3015

# ── Google (Calendar + Gmail) ────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# ── GitHub ───────────────────────────────────────────
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat

# ── Slack ────────────────────────────────────────────
SLACK_BOT_TOKEN=your_slack_bot_token
SLACK_TEAM_ID=your_slack_team_id

# ── Notion ───────────────────────────────────────────
NOTION_API_TOKEN=your_notion_token

# ── Spotify ──────────────────────────────────────────
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REFRESH_TOKEN=your_spotify_refresh_token
